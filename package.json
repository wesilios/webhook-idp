{
  "name": "node-webhook",
  "version": "1.0.0",
  "description": "Webhook Delivery Service Management",
  "private": true,
  "type": "module",
  "author": "Que Nguyen <quenguyen10190@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3",
    "yarn": ">=1.22 <2"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:claude": "node scripts/setup-claude.mjs",
    "build": "yarn workspaces run build",
    "lint": "eslint .",
    "lint:packages": "yarn workspaces run lint",
    "format": "prettier --check .",
    "test": "yarn workspaces run test",
    "infra:up": "docker compose up -d --wait mongodb rabbitmq",
    "infra:down": "docker compose stop mongodb rabbitmq",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": "eslint"
  }
}
