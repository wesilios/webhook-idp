# Copy to .env for local development (.env is gitignored — never commit real values).
# In deployed environments (dev/staging/prod), these are supplied by the platform
# (Docker env vars, Kubernetes Secret/ConfigMap, CI/CD variable injection, etc.) —
# the same built package/image is reused unchanged across environments.

NODE_ENV=development

# Optional. MongoDB connection string, read by src/app.configuration.ts. Defaults to
# mongodb://localhost:27017/webhook if unset.
MONGODB_URI=mongodb://localhost:27017/webhook

# Optional. HTTP port the server listens on. Defaults to 3000 if unset (src/main.ts); each app needs its own port for `yarn dev`.
PORT=4321

# Optional. Build version reported by `GET /versionz` (defaults to "unknown"). Set per environment by the
# deploy pipeline, so calling /versionz on any environment shows which build is running.
VERSION='1.0.0'
