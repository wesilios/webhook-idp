# In deployed environments (dev/staging/prod), these are supplied by the platform
# (Docker env vars, Kubernetes Secret/ConfigMap, CI/CD variable injection, etc.) —
# the same built package/image is reused unchanged across environments.

NODE_ENV=development

# Optional. MongoDB connection string, read by src/app.configuration.ts. Defaults to
# mongodb://localhost:27017/webhook if unset. Replace with your local MongoDB setup.
MONGODB_URI=mongodb://localhost:27017/webhook

# Required. RabbitMQ connection string and queue name this worker consumes from — must point at
# the same broker/queue the publisher (e.g. idp's sandbox) publishes onto.
RABBIT_MQ_CONN=amqp://localhost:5672
RABBIT_MQ_QUEUE=webhook_event

# Optional. HTTP port the server listens on. Defaults to 3000 if unset (src/main.ts).
PORT=4321
