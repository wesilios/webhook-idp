# Copy to .env for local development (.env is gitignored — never commit real values).
# In deployed environments (dev/staging/prod), these are supplied by the platform
# (Docker env vars, Kubernetes Secret/ConfigMap, CI/CD variable injection, etc.) —
# the same built package/image is reused unchanged across environments.

NODE_ENV=development

# Optional. HTTP port the server listens on. Defaults to 3000 if unset (src/main.ts); each app needs its own port for `yarn dev`.
PORT=4322

# Required. RabbitMQ connection string and queue name this sandbox publishes onto — must point
# at the same broker/queue event-ingestion-worker consumes from.
RABBIT_MQ_CONN=amqp://localhost:5672
RABBIT_MQ_QUEUE=webhook.events

# Application ID/Client ID. Unique identifier assigned by your identity provider (OAuth2, Entra ID, AWS Cognito, etc.).
APPLICATION_ID="7b656e3f-3434-461d-9b65-48935e0efedb"
APPLICATION_NAME=SandboxService

VERSION='1.0.0'
